# Copy to .env (never commit .env). Values are read by application.yml.
DB_URL=jdbc:postgresql://localhost:5432/cqa
DB_USER=postgres
DB_PASSWORD=change-me

# Organizers' Power Automate URL WITHOUT group_id (backend adds &group_id=...).
# It contains sig=... which is an access key: keep it secret.
ORGANIZER_URL=

# Fill only the providers you use. Empty key = provider disabled.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# NAME = operator from "меня зовут ..." in transcript, POOL = 5 demo operators
OPERATORS_MODE=NAME
CORS_ORIGINS=http://localhost:5173
